# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get this from Neon dashboard → your project → Connection string
# Make sure to select "Node.js" as the connection type
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Storage (Cloudinary vs self-hosted disk) ─────────────────────────────────
# Default is "cloudinary" (external CDN). For cPanel / VPS setups you can store
# uploaded files on the server itself; they are served back from /uploads.
STORAGE_DRIVER=cloudinary
# Directory where local files are stored (created automatically if needed).
UPLOAD_DIR=uploads
# Public origin the app runs behind when self-hosted (used to build image URLs).
# On cPanel this is your API subdomain, e.g. https://api.yourdomain.com →
# uploaded files become https://api.yourdomain.com/uploads/2026/09/….jpg
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000

# ─── Email (Resend — primary transactional email provider) ───────────────────
# When RESEND_API_KEY + RESEND_FROM_EMAIL are set, all transactional email
# (OTP verification codes, password reset codes, approvals …) is delivered via
# Resend. RESEND_FROM_EMAIL MUST be a sender verified in your Resend dashboard
# (e.g. no-reply@yourverifieddomain.com).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=DawoLife

# ─── Payments ─────────────────────────────────────────────────────────────────
# Shared secret that Chapa/TeleBirr webhooks must send in the
# "x-webhook-secret" header. Leave empty for local dev only.
PAYMENT_WEBHOOK_SECRET=
# Chapa secret key (live/test) used to verify transactions server-side.
CHAPA_SECRET_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Base URL used to build verification/email links. Local dev: http://localhost:4000.
BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Requests from other origins are blocked unless listed in allowedOrigins
# (server/src/index.ts). Set to 1 to allow all origins (local dev only).
ALLOW_ALL_ORIGINS=1
