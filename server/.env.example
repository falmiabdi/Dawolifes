# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get this from Neon dashboard → your project → Connection string
# Make sure to select "Node.js" as the connection type
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Resend — preferred transport) ────────────────────────────────────
# When RESEND_API_KEY + RESEND_FROM_EMAIL are set, all transactional email
# (OTP verification codes, password reset codes, approvals …) is delivered via
# Resend. RESEND_FROM_EMAIL MUST be a sender verified in your Resend dashboard
# (e.g. no-reply@yourverifieddomain.com). Takes priority over Brevo/SMTP.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=DawoLife

# ─── Email (Brevo transactional) ─────────────────────────────────────────────
# API key OR SMTP key — SMTP key (if set) takes priority in sendEmail.
BREVO_API_KEY=xkeysib-...
BREVO_SMTP_KEY=xsmtpsib-...
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=DawoLife

# ─── Email (Brevo SMTP relay — preferred transport) ─────────────────────────
# When these are set, all transactional email (OTP, reset codes, approvals …)
# is sent over Brevo SMTP via Nodemailer instead of the Brevo REST API.
# SMTP_FROM_EMAIL MUST be a sender verified in your Brevo dashboard.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=DawoLife-Production

# ─── Payments ─────────────────────────────────────────────────────────────────
# Shared secret that Chapa/TeleBirr webhooks must send in the
# "x-webhook-secret" header. Leave empty for local dev only.
PAYMENT_WEBHOOK_SECRET=
# Chapa secret key (live/test) used to verify transactions server-side.
CHAPA_SECRET_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Base URL used to build verification/email links. Local dev: http://localhost:4000.
BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Requests from other origins are blocked unless listed in allowedOrigins
# (server/src/index.ts). Set to 1 to allow all origins (local dev only).
ALLOW_ALL_ORIGINS=1
