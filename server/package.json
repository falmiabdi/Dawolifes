    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
