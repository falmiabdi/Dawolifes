{
  "name": "dawolife-server",
  "version": "1.0.0",
  "description": "Express backend for DawoLife real estate marketplace",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "sequelize-cli db:migrate",
