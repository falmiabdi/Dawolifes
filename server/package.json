{
  "name": "dawolife-server",
  "version": "1.0.0",
  "description": "Express backend for DawoLife real estate marketplace",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "node \"./node_modules/typescript/bin/tsc\"",
    "start": "node dist/index.js",
    "postinstall": "node \"./node_modules/prisma/build/index.js\" generate",
    "db:migrate": "node \"./node_modules/prisma/build/index.js\" migrate dev",
    "db:push": "node \"./node_modules/prisma/build/index.js\" db push",
    "db:generate": "node \"./node_modules/prisma/build/index.js\" generate",
    "db:studio": "node \"./node_modules/prisma/build/index.js\" studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "prisma": "^6.19.3",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
